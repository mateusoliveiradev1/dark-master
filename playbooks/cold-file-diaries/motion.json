{
  "channel": "Cold File Diaries",
  "default_clip_len": 7.0,
  "series_clip_len": {
    "KILLERS": 8.5,
    "VANISHED": 7.0,
    "HEISTS": 6.0,
    "SMALL TOWN": 7.0
  },
  "fps": 30,
  "size": [1920, 1080],
  "min_images": 3,
  "max_images": 40,
  "crf_clip": 20,
  "crf_final": 19,
  "audio_bitrate": "160k",
  "variants": [
    { "name": "zoom_in", "zoom": "min(zoom+0.0018,1.3)", "x": "iw/2-(iw/zoom/2)", "y": "ih/2-(ih/zoom/2)" },
    { "name": "zoom_out", "zoom": "max(1.3-0.0018*on,1.0)", "x": "iw/2-(iw/zoom/2)", "y": "ih/2-(ih/zoom/2)" },
    { "name": "pan_right", "zoom": "1.2", "x": "(iw-iw/zoom)*on/{frames}", "y": "ih/2-(ih/zoom/2)" },
    { "name": "pan_left_zoom", "zoom": "1.15+0.0005*on", "x": "(iw-iw/zoom)*(1-on/{frames})", "y": "ih/2-(ih/zoom/2)" }
  ],
  "scale": "scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080",
  "grade": {
    "vignette": "PI/4.5",
    "eq": "contrast=1.08:saturation=0.85:brightness=-0.04"
  },
  "letterbox_px": 90,
  "grain": "noise=alls=6:allf=t"
}
